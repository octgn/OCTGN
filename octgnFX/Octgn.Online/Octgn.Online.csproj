<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <Version>3.4.445.0</Version>
    <AssemblyVersion>3.4.445.0</AssemblyVersion>
    <FileVersion>3.4.445.0</FileVersion>
    <Authors>Kelly Elton</Authors>
    <Company>Octgn</Company>
    <Description>Shared library for online access in OCTGN.</Description>
    <PackageProjectUrl>http://www.octgn.net</PackageProjectUrl>
    <PackageIconUrl>http://www.octgn.net/icon.ico</PackageIconUrl>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <ReleasedCommunicationVersion>3.0.150</ReleasedCommunicationVersion>
    <Product>Octgn.Online</Product>
  </PropertyGroup>
  <PropertyGroup Condition="'$(UseReleasedCommunication)' == 'true'">
    <!-- Package builds use separate output folders; exclude existing local build artifacts. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);bin/**;obj/**</DefaultItemExcludes>
  </PropertyGroup>
  <ItemGroup Condition="'$(UseReleasedCommunication)' != 'true'">
    <ProjectReference Include="..\Octgn.Communication\Octgn.Communication\Octgn.Communication.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(UseReleasedCommunication)' == 'true'">
    <PackageReference Include="Octgn.Communication" Version="$(ReleasedCommunicationVersion)" />
  </ItemGroup>
  <Target Name="RequireReleasedCommunicationForPack" BeforeTargets="GenerateNuspec"
          Condition="'$(UseReleasedCommunication)' != 'true'">
    <Error Text="Pack Octgn.Online with scripts/Pack-Online.ps1, or set UseReleasedCommunication=true in an isolated package build. Normal client builds use the Communication project and cannot produce a publishable package." />
  </Target>
</Project>
