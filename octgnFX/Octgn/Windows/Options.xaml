<controls:DecorableWindow xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Octgn.Controls" xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" x:Class="Octgn.Windows.Options"
        Title="OCTGN Options" WindowIcon="/OCTGN;component/Resources/Icons/setting_tools.png"
        VerticalContentAlignment="Stretch" HorizontalContentAlignment="Stretch" SizeToContent="Height" VerticalAlignment="Top"
        WindowStartupLocation="CenterOwner" Width="537.424" d:DesignHeight="452" >
    <Border Background="#F0111114" CornerRadius="0,0,8,8" Padding="10,6,10,16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition />
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="1" Grid.ColumnSpan="4">
                <TextBlock x:Name="LabelError" Grid.ColumnSpan="4" Visibility="Collapsed" TextWrapping="Wrap"
                           Foreground="White" FontWeight="Bold" Background="Firebrick" Padding="5"/>

                <TabControl x:Name="TabControlOptions" Grid.Row="1" Grid.ColumnSpan="4" Grid.IsSharedSizeScope="True" Style="{StaticResource SettingsTabControl}">
                    <TabItem x:Name="TabMain" Header="Basic Options" Style="{StaticResource SettingsTabItem}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition SharedSizeGroup="TabsHeight"/>
                            </Grid.RowDefinitions>
                            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="500" Padding="0,0,6,0">
                            <StackPanel Margin="0,14,0,6">
                                <TextBlock Text="STORAGE" Style="{StaticResource EyebrowText}" Margin="2,0,0,8" />
                                <Border Style="{StaticResource Card}" Padding="16" CornerRadius="10" Margin="0,0,0,14">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource SettingLabel}">Data directory <Run Foreground="#FFFF4D4D" Text="*"/></TextBlock>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="TextBoxDataDirectory" Height="36" Padding="12,0" />
                                            <Button x:Name="ButtonPickDataDirectory" Click="ButtonPickDataDirectoryClick" Content="Browse" Grid.Column="1"
                                                    Style="{StaticResource SecondaryButton}" Height="36" Margin="8,0,0,0" Padding="16,0" />
                                        </Grid>
                                        <TextBlock Style="{StaticResource SettingLabel}" Margin="1,14,0,6">Image directory</TextBlock>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="TextBoxImageDirectory" Height="36" Padding="12,0" />
                                            <Button x:Name="ButtonPickImageDirectory" Click="ButtonPickImageDirectoryClick" Content="Browse" Grid.Column="1"
                                                    Style="{StaticResource SecondaryButton}" Height="36" Margin="8,0,0,0" Padding="16,0" />
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <TextBlock Text="APPEARANCE" Style="{StaticResource EyebrowText}" Margin="2,0,0,8" />
                                <Border Style="{StaticResource Card}" Padding="16,14" CornerRadius="10" Margin="0,0,0,14">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource SettingLabel}">Window skin <Run Foreground="#FFF5C451" Text="$"/></TextBlock>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="TextBoxWindowSkin" Height="36" Padding="12,0" />
                                            <Button x:Name="ButtonPickWindowSkin" Click="ButtonPickWindowSkinClick" Content="Browse" Grid.Column="1"
                                                    Style="{StaticResource SecondaryButton}" Height="36" Margin="8,0,0,0" Padding="16,0" />
                                        </Grid>
                                        <CheckBox x:Name="CheckBoxTileWindowSkin" Margin="0,12,0,5" Content="Tile window skin" />
                                        <TextBlock Style="{StaticResource SettingLabel}" Margin="1,12,0,6">Window border <Run Foreground="#FFFF4D4D" Text="*"/></TextBlock>
                                        <ComboBox x:Name="TextBoxWindowBorderDecorator" Height="36">
                                            <ComboBox.Items>
                                                <ComboBoxItem Tag="Native">Default operating system border</ComboBoxItem>
                                                <ComboBoxItem Tag="Octgn">Octgn border</ComboBoxItem>
                                            </ComboBox.Items>
                                        </ComboBox>
                                        <CheckBox x:Name="CheckBoxUseWindowTransparency" Margin="0,14,0,5">
                                            <TextBlock>Use window transparency <Run Foreground="{DynamicResource FaintTextBrush}" Text="(may decrease performance)"/> <Run Foreground="#FFFF4D4D" Text="*"/></TextBlock>
                                        </CheckBox>
                                        <CheckBox x:Name="CheckBoxUseHardwareRendering">
                                            <TextBlock>Use hardware rendering <Run Foreground="{DynamicResource FaintTextBrush}" Text="(may help or hurt performance)"/> <Run Foreground="#FFFF4D4D" Text="*"/></TextBlock>
                                        </CheckBox>
                                    </StackPanel>
                                </Border>

                                <TextBlock Text="GAMEPLAY" Style="{StaticResource EyebrowText}" Margin="2,0,0,8" />
                                <Border Style="{StaticResource Card}" Padding="16,14" CornerRadius="10">
                                    <StackPanel>
                                        <CheckBox x:Name="CheckBoxUseInstantSearch" Margin="0,0,0,5">
                                            <TextBlock>Use instant style searching <Run Foreground="{DynamicResource FaintTextBrush}" Text="(deck editor only)"/></TextBlock>
                                        </CheckBox>
                                        <CheckBox x:Name="CheckBoxEnableGameSounds" Content="Enable game sounds" />
                                        <CheckBox x:Name="CheckBoxEnableGameFonts" Content="Enable game fonts" />
                                        <TextBlock Style="{StaticResource SettingLabel}" Margin="1,14,0,6">When an original card image is available, zoom shows</TextBlock>
                                        <ComboBox x:Name="ComboBoxZoomOptions" Height="36">
                                            <ComboBoxItem Tag="1">Display original</ComboBoxItem>
                                            <ComboBoxItem Tag="2">Display original and proxy</ComboBoxItem>
                                            <ComboBoxItem Tag="3">Display proxy when holding CTRL</ComboBoxItem>
                                        </ComboBox>
                                        <TextBlock Style="{StaticResource SettingLabel}" Margin="1,14,0,6">Sound when someone joins your game lobby</TextBlock>
                                        <ComboBox x:Name="ComboBoxJoinSound" Height="36">
                                            <ComboBoxItem Tag="1">Ding dong</ComboBoxItem>
                                            <ComboBoxItem Tag="2">Knock knock</ComboBoxItem>
                                            <ComboBoxItem Tag="3">None</ComboBoxItem>
                                        </ComboBox>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </TabItem>
                    <TabItem x:Name="TabChatOptions" Header="Chat Options" Style="{StaticResource SettingsTabItem}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition SharedSizeGroup="TabsHeight"/>
                            </Grid.RowDefinitions>
                            <StackPanel>
                                <TextBlock Text="IN GAME CHAT" Style="{StaticResource EyebrowText}" Margin="2,16,0,8" />
                                <Border Style="{StaticResource Card}" Padding="16,12" CornerRadius="10">
                                    <CheckBox x:Name="CheckBox_InGameChat_TextShadows" Margin="0">
                                        <TextBlock Foreground="{DynamicResource TextBrush}">Apply shadows to chat text</TextBlock>
                                    </CheckBox>
                                </Border>
                                <Grid Height="6"/>
                                <GroupBox Header="Octgn Chat" Visibility="Collapsed">
                                    <StackPanel>
                                        <Grid Height="8"/>
                                        <CheckBox x:Name="CheckBoxLightChat" IsEnabled="False">
                                            <TextBlock Foreground="White">Use Light Color Chat Theme</TextBlock>
                                        </CheckBox>

                                        <Grid Height="6"/>
                                        <CheckBox x:Name="CheckBoxUseWindowsForChat" IsEnabled="False">
                                            <TextBlock Foreground="White">Use Windows Instead of Docked Chats</TextBlock>
                                        </CheckBox>

                                        <Grid Height="6"/>
                                        <CheckBox x:Name="CheckBoxEnableChatImages" IsEnabled="False" >
                                            <TextBlock Foreground="White">Enable Images in Chat
                                            <Bold Foreground="#FFFFCC00">$</Bold>
                                            </TextBlock>
                                        </CheckBox>

                                        <Grid Height="6"/>
                                        <CheckBox x:Name="CheckBoxEnableWhisperSound" IsEnabled="False">
                                            <TextBlock>Enable Alert Sound When Whispered in Chat</TextBlock>
                                        </CheckBox>

                                        <Grid Height="6"/>
                                        <CheckBox x:Name="CheckBoxEnableNameSound" Height="30" IsEnabled="False" >
                                            <TextBlock Height="30">Enable Alert Sound When Someone @username's You</TextBlock>
                                        </CheckBox>

                                        <Grid Height="6"/>
                                        <Grid IsEnabled="False">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="225"/>
                                                <ColumnDefinition />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Foreground="#FFFFFF"><Run Text="Maximum # Chat History Lines"/></TextBlock>
                                            <xctk:IntegerUpDown x:Name="MaxChatHistory"
                                                Background="#FF555555"
                                                Foreground="White"
                                                BorderBrush="Blue"
                                                Increment="1"
                                                Minimum="1"
                                                Grid.Column="1"
                                                ShowButtonSpinner="True"
                                                Height="25"
                                                AllowSpin="True" Margin="0,0,90,0"/>
                                        </Grid>
                                        <Grid Height="6"/>
                                        <Grid Margin="0,4,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="225"/>
                                                <ColumnDefinition />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Foreground="#FFFFFF"><Run Text="Chat Font Size"/></TextBlock>
                                            <xctk:IntegerUpDown x:Name="ChatFontSize"
                                                Background="#FF555555"
                                                Foreground="White"
                                                BorderBrush="Blue"
                                                Increment="1"
                                                Minimum="4"
                                                Grid.Column="1"
                                                ShowButtonSpinner="True"
                                                Height="25"
                                                AllowSpin="True" Margin="0,0,90,0"/>
                                        </Grid>
                                    </StackPanel>
                                </GroupBox>
                            </StackPanel>
                        </Grid>
                    </TabItem>
                    <TabItem x:Name="TabAdvancedOptions" Header="Advanced Options" Style="{StaticResource SettingsTabItem}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition SharedSizeGroup="TabsHeight"/>
                            </Grid.RowDefinitions>
                            <Border Style="{StaticResource Card}" Padding="16,14" CornerRadius="10" Margin="0,16,0,0" VerticalAlignment="Top">
                            <StackPanel>
                                <CheckBox x:Name="CheckBoxEnableGameSandboxing">
                                    <TextBlock Foreground="White">Enable Game Sandboxing (Recommended for Security)</TextBlock>
                                </CheckBox>
                                <Grid Height="6"/>
                                <CheckBox x:Name="CheckBoxUseTestReleases">
                                    <TextBlock Foreground="White">Opt-In to OCTGN Development Testing Version
                                        <Bold Foreground="#FFFF0000">*</Bold>
                                    </TextBlock>
                                </CheckBox>
                                <Grid Height="6"/>
                                <CheckBox x:Name="CheckBoxShowLanMode">
                                    <TextBlock Foreground="White">Allow LAN Game Hosting when Logged In </TextBlock>
                                </CheckBox>
                                <Grid Height="6"/>
                                <CheckBox x:Name="CheckBoxIgnoreSSLCertificates">
                                    <TextBlock Foreground="White" TextWrapping="Wrap">Ignore SSL Certificate Checking (use only when experiencing consistent feed errors)
                                        <Bold Foreground="#FFFF0000">*</Bold>
                                    </TextBlock>
                                </CheckBox>
                                <Grid Height="6"/>
                                <TextBlock Style="{StaticResource SettingLabel}" Margin="1,14,0,6">Card pulsing animation (when a card is moved or changed)</TextBlock>
                                <ComboBox x:Name="ComboBoxCardMoveNotification" Height="36">
                                    <ComboBoxItem Tag="1">No Animation</ComboBoxItem>
                                    <ComboBoxItem Tag="2">Normal Animation</ComboBoxItem>
                                    <ComboBoxItem Tag="3">Minimal Animation</ComboBoxItem>
                                </ComboBox>
                                <Grid Height="6"/>
                                <TextBlock Style="{StaticResource SettingLabel}" Margin="1,14,0,6">Default card density in expanded piles (minimum % of card to show)</TextBlock>
                                <Slider x:Name="HandDensitySlider" TickPlacement="BottomRight" Maximum="100" Minimum="1"
                                        LargeChange="10" SmallChange="1" TickFrequency="10" AutoToolTipPlacement="BottomRight"/>
                            </StackPanel>
                            </Border>
                        </Grid>
                    </TabItem>
                </TabControl>
                <Grid Height="10"/>
                <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource MutedTextBrush}" FontSize="12">
                    <Bold Foreground="#FFF5C451">$</Bold> Subscriber only
                </TextBlock>
                <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource MutedTextBrush}" FontSize="12">
                    <Bold Foreground="#FFFF4D4D">*</Bold> Requires a restart to take effect
                </TextBlock>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                    <Button x:Name="ButtonCancel" Click="ButtonCancelClick" Content="Cancel" Margin="0,0,10,0"
                    Height="40" Width="110" Style="{StaticResource SecondaryButton}"/>
                    <Button x:Name="ButtonSave" Click="ButtonSaveClick" Content="Save changes"
                    Height="40" Width="140" Style="{StaticResource PrimaryButton}"/>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
</controls:DecorableWindow>
