<Controls:DecorableWindow 
        x:Class="Octgn.Windows.UpdateChecker" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
        xmlns:Controls="clr-namespace:Octgn.Controls"
        Title="Loading Octgn..." MinHeight="237" MinWidth="438" Height="Auto" Width="500"
        WindowStartupLocation="CenterScreen" WindowIcon="pack://application:,,,/OCTGN;component/Resources/Icon.ico" 
        ResizeMode="CanResizeWithGrip" ShowInTaskbar="True" Topmost="False" 
        Closing="Window_Closing" CloseButtonVisibility="Collapsed" MinimizeButtonVisibility="Collapsed"
        SizeToContent="Height"
        x:Name="self">

    <Border BorderBrush="#FF2A2A31" BorderThickness="1" Name="border1" Background="#FF0C0C0E">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="3" />
            </Grid.RowDefinitions>
            <Image Source="{Binding ElementName=self,Path=AdSource}" Stretch="Uniform" HorizontalAlignment="Stretch"/>
            <Border Grid.Row="1" Background="#FF141418" BorderBrush="#FF26262C" BorderThickness="0,1,0,0" Padding="18,14">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE895;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#FFFF4D4D" VerticalAlignment="Center" Margin="0,1,12,0" />
                    <TextBlock Foreground="#FFF2F2F4" FontSize="13.5" FontWeight="SemiBold" Text="Checking for updates..."
                               Name="lblStatus" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Border>
            <ProgressBar Height="3" Name="progressBar1" IsIndeterminate="True" Grid.Row="2" MouseDoubleClick="ProgressBarMouseDoubleClick"/>
            <ScrollViewer Grid.Row="0" Grid.RowSpan="2" x:Name="LogItemsScroller" Visibility="Collapsed">
                <StackPanel x:Name="LogItems">

                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</Controls:DecorableWindow>