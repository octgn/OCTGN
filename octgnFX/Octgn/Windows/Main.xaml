<Controls:DecorableWindow
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:Controls="clr-namespace:Octgn.Controls"
        xmlns:gameManagement="clr-namespace:Octgn.Tabs.GameManagement" xmlns:profile="clr-namespace:Octgn.Tabs.Profile"
    xmlns:watch="clr-namespace:Octgn.Tabs.Watch"
    xmlns:challengeBoards="clr-namespace:Octgn.Tabs.ChallengeBoards"
    xmlns:login="clr-namespace:Octgn.Tabs.Login"
    xmlns:playtab="clr-namespace:Octgn.Tabs.Play"
    xmlns:historytab="clr-namespace:Octgn.Tabs.GameHistory"
    xmlns:converters="clr-namespace:Octgn.Utils.Converters"
    xmlns:windows="clr-namespace:Octgn.Windows"
    x:Class="Octgn.Windows.Main"
        Title="OCTGN"
    x:Name="me"
        Height="600" Width="1024"
        MinHeight="600" MinWidth="800" WindowIcon="pack://application:,,,/OCTGN;component/Resources/Icon.ico"
    >
    <Grid x:Name="GridMain">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0">
            <Controls:UpdateBar/>
        </StackPanel>
        <TabControl x:Name="TabControlMain" Grid.Row="1" Style="{StaticResource NavRail}">
            <TabItem x:Name="TabMain" Header="Home" Tag="&#xE80F;" Style="{StaticResource NavRailItem}">
                <login:LoginTab></login:LoginTab>
            </TabItem>
            <TabItem x:Name="TabCustomGames" Header="Game Lobby" Tag="&#xE7FC;" Style="{StaticResource NavRailItem}">
                <playtab:PlayTab x:Name="TabCustomGamesList"></playtab:PlayTab>
            </TabItem>
            <TabItem x:Name="TabItemHistory" Header="Game History" Tag="&#xE81C;" Style="{StaticResource NavRailItem}">
                <historytab:GameHistoryTab x:Name="TabHistory"/>
            </TabItem>
            <TabItem x:Name="TabWatch" Header="Twitch.tv" Tag="&#xE714;" Style="{StaticResource NavRailItem}">
                <watch:WatchList/>
            </TabItem>
            <TabItem Header="Games Manager" Tag="&#xE8F1;" IsEnabled="true" Style="{StaticResource NavRailItem}">
                <gameManagement:GameManagement></gameManagement:GameManagement>
            </TabItem>
            <TabItem Header="Challenge Board" Tag="&#xE7C1;" x:Name="ChallengeBoardTab" Style="{StaticResource NavRailItem}">
                <challengeBoards:ChallengeBoards/>
            </TabItem>
            <TabItem Header="Profile" Tag="&#xE77B;" IsEnabled="false" x:Name="ProfileTab" Style="{StaticResource NavRailItem}">
                <profile:UserProfilePage x:Name="ProfileTabContent"></profile:UserProfilePage>
            </TabItem>
            <TabControl.Tag>
            <!-- Utilities and connection status live at the foot of the navigation sidebar -->
            <StackPanel>
                <Border Height="1" Background="{DynamicResource HairlineBrush}" Margin="4,0,4,10" />
                <Menu Style="{StaticResource SidebarMenu}">
                    <MenuItem x:Name="menuOptions" Header="_Options" ToolTip="Options" Tag="&#xE713;" Click="MenuOptionsClick" Style="{StaticResource SidebarMenuItem}"/>
                    <MenuItem Header="_Deck Editor" ToolTip="Deck Editor" Tag="&#xE70F;" Click="MenuDeckEditorClick" Style="{StaticResource SidebarMenuItem}"/>
                    <MenuItem Header="_Help" ToolTip="Help" Tag="&#xE897;" Style="{StaticResource SidebarMenuItem}">
                        <MenuItem x:Name="menuHelp" Header="Get _Help Online" MinWidth="170" Click="MenuHelpClick"/>
                        <MenuItem x:Name="menuDiag" Header="_Diagnostics" MinWidth="170" Click="MenuDiagClick"/>
                        <MenuItem x:Name="menuAbout" Header="_About" MinWidth="170" Click="MenuAboutClick"/>
                    </MenuItem>
                    <MenuItem Header="Open _Source" ToolTip="Open Source" Tag="&#xE943;" Style="{StaticResource SidebarMenuItem}">
                        <MenuItem Header="And We Accept _Pull Requests" Click="MenuPullRequestClick"></MenuItem>
                        <MenuItem Header="_Source Code" Click="MenuSourceCodeClick"></MenuItem>
                    </MenuItem>
                    <MenuItem Header="Su_bscribe" ToolTip="Subscribe" Tag="&#xE735;" Click="MenuSubscribeClick" Foreground="#FFF5C451" Style="{StaticResource SidebarMenuItem}"/>
                    <MenuItem Header="Do_nate" ToolTip="Donate" Tag="&#xEB52;" Click="MenuDonateClick" Foreground="#FFFF5A5A" Style="{StaticResource SidebarMenuItem}"/>
                </Menu>
                <Border Style="{StaticResource StatusPill}" Margin="4,12,4,0" HorizontalAlignment="Stretch">
                    <Border.Resources>
                        <converters:ConnectionStatusConverter x:Key="ConnectionStatusConverter"/>
                    </Border.Resources>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="8" Height="8" Margin="0,0,10,0" VerticalAlignment="Center"
                                 Fill="{Binding ConnectionStatus, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type windows:Main}}, Converter={StaticResource ConnectionStatusConverter}}">
                        </Ellipse>
                        <Label VerticalAlignment="Center" Padding="0" FontSize="12"
                               Content="{Binding ConnectionStatus, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type windows:Main}}, Converter={StaticResource ConnectionStatusConverter}}"
                               Foreground="{DynamicResource MutedTextBrush}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
            </TabControl.Tag>
        </TabControl>

    </Grid>
</Controls:DecorableWindow>
