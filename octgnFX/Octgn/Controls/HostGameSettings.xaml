<UserControl x:Class="Octgn.Controls.HostGameSettings"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:controls="clr-namespace:Octgn.Controls"
             mc:Ignorable="d" d:DesignWidth="650"
             Panel.ZIndex="5">
    <Border x:Name="BorderHostGame" MinHeight="200" Visibility="Visible" Padding="0"
            Style="{StaticResource Panel}" CornerRadius="14" ClipToBounds="True"
            BorderThickness="1" BorderBrush="#FF2A2A31"
            Background="#FF0C0C0E">
        <Border.Effect>
            <DropShadowEffect BlurRadius="36" ShadowDepth="8" Direction="270" Opacity="0.6" Color="Black"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="1*"/>
            </Grid.RowDefinitions>
            <Border Grid.Row="1" Grid.RowSpan="2" Panel.ZIndex="-1">
                <controls:GameSelector x:Name="GameSelector">
                    <controls:GameSelector.Effect>
                        <DropShadowEffect BlurRadius="50" ShadowDepth="0" Opacity="1"
                                          Color="White" RenderingBias="Performance"/>
                    </controls:GameSelector.Effect>
                </controls:GameSelector>
            </Border>
            <!-- Shown when no games are installed yet -->
            <StackPanel Grid.Row="1" Margin="320,0,0,0" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasItems, ElementName=ComboBoxGame}" Value="False">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <Grid Width="84" Height="84" HorizontalAlignment="Center">
                    <Ellipse Fill="#14FF0000" Stroke="#33FF0000" StrokeThickness="1" />
                    <TextBlock Text="&#xE7FC;" FontFamily="{StaticResource IconFont}" FontSize="34" Foreground="#FFFF5A5A" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>
                <TextBlock Text="No games installed yet" FontFamily="{StaticResource DisplayFont}" FontSize="18" Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Center" Margin="0,18,0,4" />
                <TextBlock Text="Install a game from the Games Manager, then come back to host a table." Style="{StaticResource BodyMutedText}" HorizontalAlignment="Center" TextAlignment="Center" MaxWidth="320" />
            </StackPanel>            <Border VerticalAlignment="Top"
                    Name="ErrorMessageBorder"
                    Grid.Row="1"
                    Margin="200 10 5 5"
                    Panel.ZIndex="10"
                    HorizontalAlignment="Stretch"
                    Opacity="1"
                    ClipToBounds="True"
                    Grid.ColumnSpan="2">
                <Border BorderBrush="#AADC143C"
                        Height="40"
                        BorderThickness="1"
                        CornerRadius="3">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="5" Color="#AADC143C" ShadowDepth="0"/>
                    </Border.Effect>
                    <Border.Style>
                        <Style TargetType="Border">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasError, RelativeSource={RelativeSource AncestorType=controls:HostGameSettings}}"
                                             Value="True">
                                    <DataTrigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Duration="0:0:0.3"
                                                                 From="0" To="1"
                                                                 Storyboard.TargetProperty="Opacity"/>
                                                <ThicknessAnimation Duration="0:0:0.5"
                                                                    From="0 -60 0 0"
                                                                    To="0 0 0 0"
                                                                    Storyboard.TargetProperty="Margin">
                                                    <ThicknessAnimation.EasingFunction>
                                                        <BackEase EasingMode="EaseOut"  Amplitude="0.5"/>
                                                    </ThicknessAnimation.EasingFunction>
                                                </ThicknessAnimation>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.EnterActions>
                                    <DataTrigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Duration="0:0:0.2"
                                                                 To="0" From="1"
                                                                 Storyboard.TargetProperty="Opacity"/>
                                                <ThicknessAnimation Duration="0:0:0.5"
                                                                    To="0 -60 0 0"
                                                                    From="0"
                                                                    Storyboard.TargetProperty="Margin">
                                                    <ThicknessAnimation.EasingFunction>
                                                        <BackEase EasingMode="EaseOut"  Amplitude="0.5"/>
                                                    </ThicknessAnimation.EasingFunction>
                                                </ThicknessAnimation>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.ExitActions>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock FontFamily="Segoe MDL2 Assets"
                                   Text="&#xE7BA;"
                                   FontSize="18" Foreground="White"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center"
                                   Grid.Column="0"/>
                        <Border Background="#AAFF0048" Grid.Column="1">
                            <TextBlock Foreground="White" Padding="10 5 80 5"
                                       FontSize="12"
                                       Grid.Column="1"
                                       TextWrapping="Wrap"
                                       x:Name="ErrorText"
                                       Text="lorem ipsem in the dalawe flwelkfj alwekj falwkejflakwjefliawje lawiemf ;alwiem aowimef oawimefoaiwme foaiwem "/>
                        </Border>
                    </Grid>
                            <!--<Border Margin="0,10,0,10" BorderBrush="Crimson" BorderThickness="1" x:Name="ErrorMessageBorder" Visibility="Collapsed">
                                <TextBlock Foreground="White" Padding="5 2"
                                       TextWrapping="Wrap" Background="#FF0048"
                                       Text="{Binding Error, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type controls:HostGameSettings}}}"/>
                            </Border>-->
                </Border>
            </Border>
            <Border Grid.Row="1" Style="{StaticResource Panel}"
                    Padding="24 20 24 20"
                    Background="#FF141418" BorderThickness="0 0 1 0" BorderBrush="#FF26262C"
                    CornerRadius="0 0 0 0" HorizontalAlignment="Left"
                    Width="320">
                <Grid VerticalAlignment="Stretch">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="76"/>
                        <RowDefinition Height="1*"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel VerticalAlignment="Top">
                        <TextBlock Text="Start a game" Style="{StaticResource HeadingText}" FontSize="22" />
                        <TextBlock Text="Pick a game and name your table." Style="{StaticResource BodyMutedText}" FontSize="12.5" Margin="0 4 0 0" />
                    </StackPanel>

                    <StackPanel Grid.Row="1">
                        <TextBlock Text="Username" Style="{StaticResource EyebrowText}" Margin="2 0 0 6" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="48*"/>
                                <ColumnDefinition Width="125*"/>
                                <ColumnDefinition Width="30"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="TextBoxUserName" Grid.ColumnSpan="3" Height="40" Padding="12 0 40 0"/>
                            <Button x:Name="ButtonRandomizeUserName" Grid.Column="2" Click="ButtonRandomizeUserNameClick" Style="{StaticResource GhostButton}"
                                    Width="32" Height="32" MinHeight="0" Padding="0" HorizontalAlignment="Right" Margin="0 0 4 0" ToolTip="Random name">
                                <TextBlock Text="&#xE8B1;" FontFamily="{StaticResource IconFont}" FontSize="13" />
                            </Button>
                        </Grid>
                        <TextBlock Text="Game name" Style="{StaticResource EyebrowText}" Margin="2 14 0 6" />
                        <Grid Grid.Row="6" Grid.Column="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100*"/>
                                <ColumnDefinition Width="30"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="TextBoxGameName" Grid.ColumnSpan="2" Height="40" Padding="12 0 40 0"/>
                            <Button x:Name="ButtonRandomizeGameName" Grid.Column="1" Click="ButtonRandomizeGameNameClick" Style="{StaticResource GhostButton}"
                                    Width="32" Height="32" MinHeight="0" Padding="0" HorizontalAlignment="Right" Margin="0 0 4 0" ToolTip="Random name">
                                <TextBlock Text="&#xE8B1;" FontFamily="{StaticResource IconFont}" FontSize="13" />
                            </Button>
                        </Grid>
                        <StackPanel Orientation="Horizontal" Margin="2 14 0 6">
                            <TextBlock Text="&#xE735;" FontFamily="{StaticResource IconFont}" FontSize="10" Foreground="#FFF5C451" VerticalAlignment="Center" Margin="0 0 6 0" ToolTip="Subscriber feature" />
                            <TextBlock Text="Password" Style="{StaticResource EyebrowText}" VerticalAlignment="Center" />
                        </StackPanel>
                        <PasswordBox Grid.Row="8" Grid.Column="1" x:Name="PasswordGame" IsEnabled="False" Height="40" Padding="12 0"/>
                        <TextBlock Text="Game" Style="{StaticResource EyebrowText}" Margin="2 14 0 6" />
                        <ComboBox Grid.Row="10" Grid.Column="1" x:Name="ComboBoxGame" Height="40" ItemsSource="{Binding Games, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type controls:HostGameSettings}}}"></ComboBox>
                        <StackPanel x:Name="StackPanelIsLocalGame" Orientation="Horizontal" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Visibility="Collapsed" Margin="0 34 0 0">
                            <CheckBox x:Name="CheckBoxIsLocalGame" Margin="2,1,0,0" Content="" HorizontalAlignment="Left" Checked="CheckBoxIsLocalGame_OnChecked" Unchecked="CheckBoxIsLocalGame_OnUnchecked" Visibility="Visible"/>
                            <Label x:Name="LabelIsLocalGame" Content="Host Game on LAN" />
                        </StackPanel>
                    </StackPanel>
                    <ProgressBar Grid.Row="2" Grid.ColumnSpan="2" x:Name="ProgressBar" Height="20"
                                 VerticalAlignment="Bottom" Visibility="Collapsed" Margin="0,0,0,10"
                                 IsIndeterminate="true" BorderBrush="#111"/>
                    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Left">
                        <Button Width="100" Height="40" HorizontalAlignment="Left" Click="ButtonCancelClick" Content="Cancel"
                                Margin="0 0 10 0"
                                Style="{StaticResource SecondaryButton}">
                        </Button>

                        <Button Width="150" Height="40" HorizontalAlignment="Right" Click="ButtonHostGameStartClick" Content="Start game" Style="{StaticResource PrimaryButton}">
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
