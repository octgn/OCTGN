<UserControl x:Class="Octgn.Tabs.Play.PlayTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:utils="clr-namespace:Octgn.Utils"
             xmlns:local="clr-namespace:Octgn.Tabs.Play"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="870"
             x:Name="Me">
    <UserControl.Resources>
        <DataTemplate x:Key="IconTemplate">
                <Image Source="/OCTGN;component/Resources/lock.png"
                           Stretch="UniformToFill"
                           Height="16"
                           Visibility="{Binding Path=HasPassword,Converter={StaticResource BooleanToVisibilityConverter}}"/>
            </DataTemplate>
        <DataTemplate x:Key="UserIconTemplate">
            <Image Source="{Binding Path=UserImage}"
                           Stretch="UniformToFill"
                           Height="16" Width="16" Margin="0"/>
        </DataTemplate>
    </UserControl.Resources>
    <Grid Margin="32,26,32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition MinHeight="120" Height="*"/>
            <RowDefinition Height="14" />
            <RowDefinition MinHeight="120" Height="*" />
        </Grid.RowDefinitions>
        <Border x:Name="DialogPlaceHolder" Grid.RowSpan="8" Panel.ZIndex="10" Margin="-32,-26,-32,-24"></Border>

        <!-- Page header: title on the left, actions on the right -->
        <DockPanel x:Name="BorderButtons" Grid.Row="0" IsEnabled="{Binding LoadingGame, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:PlayTab}}}">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Click="ButtonKillGame" Style="{StaticResource FlatDarkRedButtonStyle}" Height="38" Margin="0,0,10,0"
                        Visibility="{Binding ElementName=Me,Path=ShowKillGameButton,Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE711;" FontFamily="{StaticResource IconFont}" FontSize="12" VerticalAlignment="Center" Margin="0,1,8,0" />
                        <TextBlock Text="Kill Game" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Click="ButtonJoinOfflineGame" Style="{StaticResource SecondaryButton}" Height="38" Margin="0,0,10,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE71B;" FontFamily="{StaticResource IconFont}" FontSize="13" VerticalAlignment="Center" Margin="0,1,8,0" />
                        <TextBlock Text="Connect to a game" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Click="ButtonJoinClick" Style="{StaticResource SecondaryButton}" Height="38" Margin="0,0,10,0"
                        IsEnabled="{Binding IsJoinableGameSelected, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:PlayTab}}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE768;" FontFamily="{StaticResource IconFont}" FontSize="12" VerticalAlignment="Center" Margin="0,1,8,0" />
                        <TextBlock Text="Join" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Click="ButtonHostClick" Style="{StaticResource PrimaryButton}" Height="38">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFont}" FontSize="13" VerticalAlignment="Center" Margin="0,1,8,0" />
                        <TextBlock Text="Host a game" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Game Lobby" Style="{StaticResource HeadingText}" FontSize="26" />
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <Border Background="#1FFF0000" BorderBrush="#40FF0000" BorderThickness="1" CornerRadius="10" Padding="8,2" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="6" Height="6" Fill="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="#FFFF8080" VerticalAlignment="Center">
                                <Run Text="{Binding GameCount, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:PlayTab}}}" />
                                <Run Text="games" />
                            </TextBlock>
                        </StackPanel>
                    </Border>
                    <CheckBox VerticalAlignment="Center" IsChecked="{Binding ElementName=Me, Path=HideUninstalledGames}" Margin="16,0,0,0"
                              Foreground="{DynamicResource MutedTextBrush}" Content="Only show installed games" />
                </StackPanel>
            </StackPanel>
        </DockPanel>

        <ProgressBar Grid.Row="1" Height="3" Margin="0,14,0,0" BorderThickness="0" Background="#FF1A1A1E" IsIndeterminate="{Binding ElementName=Me,Path=IsRefreshingGameList}" Maximum="200" Minimum="0">
            <ProgressBar.Style>
                <Style TargetType="{x:Type ProgressBar}" BasedOn="{StaticResource {x:Type ProgressBar}}">
                    <Style.Resources>
                        <Storyboard x:Key="InitialRefreshDelayAnimation">
                            <DoubleAnimation From="200" To="0" Storyboard.TargetProperty="Value" Duration="{x:Static local:PlayTab.InitialRefreshDelay}" />
                        </Storyboard>
                        <Storyboard x:Key="NormalRefreshDelayAnimation">
                            <DoubleAnimation From="200" To="0" Storyboard.TargetProperty="Value" Duration="{x:Static local:PlayTab.NormalRefreshDelay}" />
                        </Storyboard>
                    </Style.Resources>
                    <Style.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding ElementName=Me, Path=IsRefreshingGameList}" Value="False"/>
                                <Condition Binding="{Binding ElementName=Me, Path=IsInitialRefresh}" Value="True"/>
                            </MultiDataTrigger.Conditions>
                            <MultiDataTrigger.EnterActions>
                                <BeginStoryboard Name="InitialRefreshDelayBeginStoryboard" Storyboard="{StaticResource InitialRefreshDelayAnimation}"/>
                            </MultiDataTrigger.EnterActions>
                            <MultiDataTrigger.ExitActions>
                                <StopStoryboard BeginStoryboardName="InitialRefreshDelayBeginStoryboard"/>
                            </MultiDataTrigger.ExitActions>
                        </MultiDataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding ElementName=Me, Path=IsRefreshingGameList}" Value="False"/>
                                <Condition Binding="{Binding ElementName=Me, Path=IsInitialRefresh}" Value="False"/>
                            </MultiDataTrigger.Conditions>
                            <MultiDataTrigger.EnterActions>
                                <BeginStoryboard Name="NormalRefreshDelayBeginStoryboard" Storyboard="{StaticResource NormalRefreshDelayAnimation}"/>
                            </MultiDataTrigger.EnterActions>
                            <MultiDataTrigger.ExitActions>
                                <StopStoryboard BeginStoryboardName="NormalRefreshDelayBeginStoryboard"/>
                            </MultiDataTrigger.ExitActions>
                        </MultiDataTrigger>
                        <DataTrigger Binding="{Binding ElementName=Me, Path=IsRefreshingGameList}" Value="False">
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ProgressBar.Style>
        </ProgressBar>

        <!-- Shown until the user signs in -->
        <Border Grid.Row="2" Margin="0,16,0,0" Background="#14FFFFFF" BorderBrush="#FF2A2A30" BorderThickness="1" CornerRadius="10" Padding="14,12"
                Visibility="{Binding ElementName=Me, Path=IsLoggedIn, Converter={StaticResource InvertedBooleanToVisibilityConverter}}">
            <DockPanel>
                <Border DockPanel.Dock="Left" Width="30" Height="30" CornerRadius="15" Background="#26FF0000" Margin="0,0,12,0" VerticalAlignment="Top">
                    <TextBlock Text="&#xE946;" FontFamily="{StaticResource IconFont}" FontSize="14" Foreground="#FFFF6B6B" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="You're browsing offline" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextBrush}" />
                    <TextBlock Style="{StaticResource BodyMutedText}" FontSize="12.5" Margin="0,2,0,0"
                               Text="Only games hosted on your local network are listed. Sign in on the Home tab to see games hosted online." />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Open tables -->
        <Border Grid.Row="4" Style="{StaticResource Card}" Padding="0" Margin="0,16,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" Margin="18,14,18,6">
                    <TextBlock Text="&#xE716;" FontFamily="{StaticResource IconFont}" FontSize="13" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <TextBlock Text="OPEN TABLES" Style="{StaticResource EyebrowText}" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="  ·  waiting for players, double-click to join" FontSize="12" Foreground="{DynamicResource FaintTextBrush}" VerticalAlignment="Center" />
                </StackPanel>
                <ListView x:Name="HostingGamesList" Grid.Row="1"
                          SelectedValue="{Binding ElementName=Me, Path=SelectedGame}"
                          AlternationCount="1"
                          SelectionMode="Single"
                          utils:GridViewSort.AutoSort="True"
                          ItemsSource="{Binding HostedGameList, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:PlayTab}}}" >
                    <ListView.ItemContainerStyle>
                        <Style TargetType="{x:Type ListViewItem}" BasedOn="{StaticResource TableRow}">
                            <Setter Property="Visibility" Value="Visible" />
                            <EventSetter Event="MouseDoubleClick" Handler="GameListItemDoubleClick"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Status}" Value="GameInProgress">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Status}" Value="StoppedHosting">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding CanPlay}" Value="False" />
                                        <Condition Binding="{Binding ElementName=Me, Path=HideUninstalledGames}" Value="True"/>
                                    </MultiDataTrigger.Conditions>
                                    <MultiDataTrigger.Setters>
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </MultiDataTrigger.Setters>
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.View>
                        <GridView>
                            <GridViewColumn CellTemplate="{StaticResource UserIconTemplate}" Width="35"></GridViewColumn>
                            <GridViewColumn CellTemplate="{StaticResource IconTemplate}" Width="25"></GridViewColumn>
                            <GridViewColumn Header="User"
                                            utils:GridViewSort.PropertyName="UserName"
                                            DisplayMemberBinding="{Binding Path=UserName}" Width="100"></GridViewColumn>
                            <GridViewColumn Header="Game"
                                            utils:GridViewSort.PropertyName="GameName"
                                            DisplayMemberBinding="{Binding Path=GameName}" Width="220"></GridViewColumn>
                            <GridViewColumn Header="Name"
                                            utils:GridViewSort.PropertyName="Name"
                                            DisplayMemberBinding="{Binding Path=Name}" Width="300"></GridViewColumn>
                            <GridViewColumn Header="RunTime"
                                            utils:GridViewSort.PropertyName="StartTime"
                                            DisplayMemberBinding="{Binding Path=RunTime}" Width="70"></GridViewColumn>
                            <GridViewColumn Header="Source"
                                            utils:GridViewSort.PropertyName="Source"
                                            DisplayMemberBinding="{Binding Path=GameSource}" Width="50"></GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>
            </Grid>
        </Border>

        <GridSplitter Grid.Row="5" Height="14" HorizontalAlignment="Stretch" VerticalAlignment="Center" Background="Transparent"
                      ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" Cursor="SizeNS" />
        <Border Grid.Row="5" Width="40" Height="4" CornerRadius="2" Background="#FF2E2E35" IsHitTestVisible="False" VerticalAlignment="Center" />

        <!-- Games in progress -->
        <Border Grid.Row="6" Style="{StaticResource Card}" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" Margin="18,14,18,6">
                    <TextBlock Text="&#xE7B3;" FontFamily="{StaticResource IconFont}" FontSize="13" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <TextBlock Text="IN PROGRESS" Style="{StaticResource EyebrowText}" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="  ·  double-click to spectate" FontSize="12" Foreground="{DynamicResource FaintTextBrush}" VerticalAlignment="Center" />
                </StackPanel>
                <ListView x:Name="SpectatingGamesList" Grid.Row="1"
                          SelectedValue="{Binding ElementName=Me, Path=SelectedGame}"
                          AlternationCount="1"
                          SelectionMode="Single"
                          utils:GridViewSort.AutoSort="True"
                          ItemsSource="{Binding HostedGameList, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:PlayTab}}}" >
                    <ListView.View>
                        <GridView>
                            <GridViewColumn CellTemplate="{StaticResource UserIconTemplate}" Width="35"></GridViewColumn>
                            <GridViewColumn CellTemplate="{StaticResource IconTemplate}" Width="25"></GridViewColumn>
                            <GridViewColumn Header="User"
                                            utils:GridViewSort.PropertyName="UserName"
                                            DisplayMemberBinding="{Binding Path=UserName}" Width="100"></GridViewColumn>
                            <GridViewColumn Header="Game"
                                            utils:GridViewSort.PropertyName="GameName"
                                            DisplayMemberBinding="{Binding Path=GameName}" Width="220"></GridViewColumn>
                            <GridViewColumn Header="Name"
                                            utils:GridViewSort.PropertyName="Name"
                                            DisplayMemberBinding="{Binding Path=Name}" Width="300"></GridViewColumn>
                            <GridViewColumn Header="RunTime"
                                            utils:GridViewSort.PropertyName="StartTime"
                                            DisplayMemberBinding="{Binding Path=RunTime}" Width="70"></GridViewColumn>
                            <GridViewColumn Header="Source"
                                            utils:GridViewSort.PropertyName="Source"
                                            DisplayMemberBinding="{Binding Path=GameSource}" Width="50"></GridViewColumn>
                        </GridView>
                    </ListView.View>
                    <ListView.ItemContainerStyle>
                        <Style TargetType="{x:Type ListViewItem}" BasedOn="{StaticResource TableRow}">
                            <Setter Property="Visibility" Value="Visible" />
                            <EventSetter Event="MouseDoubleClick" Handler="GameListItemDoubleClick"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Status}" Value="StartedHosting">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Status}" Value="StoppedHosting">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding CanPlay}" Value="False" />
                                        <Condition Binding="{Binding ElementName=Me, Path=HideUninstalledGames}" Value="True"/>
                                    </MultiDataTrigger.Conditions>
                                    <MultiDataTrigger.Setters>
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </MultiDataTrigger.Setters>
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ListView.ItemContainerStyle>
                </ListView>
            </Grid>
        </Border>
    </Grid>
</UserControl>