<UserControl x:Class="Octgn.Tabs.Play.PlayTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:utils="clr-namespace:Octgn.Utils"
             xmlns:local="clr-namespace:Octgn.Tabs.Play"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="870"
             x:Name="Me">
    <UserControl.Resources>
        <!-- Avatar: circular user image on a neutral disc -->
        <DataTemplate x:Key="UserIconTemplate">
            <Grid Width="28" Height="28" Margin="0,0,0,0" HorizontalAlignment="Left">
                <Ellipse Fill="#FF2A2A30" />
                <Image Source="{Binding Path=UserImage}" Stretch="UniformToFill" Width="28" Height="28">
                    <Image.Clip>
                        <EllipseGeometry Center="14,14" RadiusX="14" RadiusY="14" />
                    </Image.Clip>
                </Image>
                <Ellipse Stroke="#33FFFFFF" StrokeThickness="1" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="UserNameTemplate">
            <TextBlock Text="{Binding Path=UserName}" FontSize="13" Foreground="{DynamicResource TextBrush}"
                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,10,0" />
        </DataTemplate>

        <DataTemplate x:Key="GameNameTemplate">
            <TextBlock Text="{Binding Path=GameName}" FontSize="13" Foreground="{DynamicResource MutedTextBrush}"
                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,10,0" />
        </DataTemplate>

        <!-- Table name (primary text) with status chips on the right -->
        <DataTemplate x:Key="TableNameTemplate">
            <DockPanel LastChildFill="True" Margin="0,0,10,0" VerticalAlignment="Center">
                <Border DockPanel.Dock="Right" Margin="8,0,0,0" CornerRadius="11" Padding="7,2" VerticalAlignment="Center"
                        Background="#1AFFFFFF" BorderBrush="#26FFFFFF" BorderThickness="1"
                        ToolTip="Password protected"
                        Visibility="{Binding Path=HasPassword,Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="&#xE72E;" FontFamily="{StaticResource IconFont}" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" />
                </Border>
                <Border DockPanel.Dock="Right" Margin="8,0,0,0" CornerRadius="11" Padding="8,2" VerticalAlignment="Center"
                        Background="#1AFFB84D" BorderBrush="#40FFB84D" BorderThickness="1"
                        ToolTip="This game is not installed on your machine">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CanPlay}" Value="False">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="Not installed" FontSize="12" FontWeight="SemiBold" Foreground="#FFFFC875" />
                </Border>
                <TextBlock Text="{Binding Path=Name}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"
                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
            </DockPanel>
        </DataTemplate>

        <DataTemplate x:Key="RunTimeTemplate">
            <TextBlock Text="{Binding Path=RunTime}" Style="{StaticResource CaptionText}"
                       VerticalAlignment="Center" Margin="0,0,10,0" />
        </DataTemplate>

        <DataTemplate x:Key="SourceTemplate">
            <Border HorizontalAlignment="Left" VerticalAlignment="Center" CornerRadius="11" Padding="9,2" Margin="0,0,10,0"
                    Background="#0FFFFFFF" BorderBrush="#26FFFFFF" BorderThickness="1">
                <TextBlock Text="{Binding Path=GameSource}" Style="{StaticResource CaptionText}" />
            </Border>
        </DataTemplate>

        <!-- Lobby row: soft hover, red-glow selection with marker, 120-180ms transitions -->
        <Style x:Key="LobbyRow" TargetType="{x:Type ListViewItem}">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="MinHeight" Value="44" />
            <Setter Property="Margin" Value="6,1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListViewItem}">
                        <Grid>
                            <Border x:Name="Hover" CornerRadius="8" Background="{DynamicResource SurfaceHoverBrush}" Opacity="0" />
                            <Border x:Name="Selected" CornerRadius="8" Background="{StaticResource SelectionGlowBrush}"
                                    BorderBrush="#40FF0000" BorderThickness="1" Opacity="0" />
                            <Border x:Name="Marker" Width="3" HorizontalAlignment="Left" Margin="0,10" CornerRadius="1.5"
                                    Background="{DynamicResource AccentBrush}" Opacity="0" />
                            <GridViewRowPresenter Margin="4,0" VerticalAlignment="Center" Columns="{TemplateBinding GridView.ColumnCollection}"
                                                  Content="{TemplateBinding Content}" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True" />
                                    <Condition Property="IsSelected" Value="False" />
                                </MultiTrigger.Conditions>
                                <MultiTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </MultiTrigger.EnterActions>
                                <MultiTrigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </MultiTrigger.ExitActions>
                            </MultiTrigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Selected" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15" />
                                            <DoubleAnimation Storyboard.TargetName="Marker" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Selected" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18" />
                                            <DoubleAnimation Storyboard.TargetName="Marker" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- One caption style for all small text (12.5px, muted: 4.5:1+ on the card surfaces) -->
        <Style x:Key="CaptionText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
            <Setter Property="Effect" Value="{x:Null}" />
        </Style>

        <!-- Column headers: muted, never faint, 12px -->
        <Style x:Key="LobbyColumnHeader" TargetType="{x:Type GridViewColumnHeader}" BasedOn="{StaticResource {x:Type GridViewColumnHeader}}">
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
        </Style>

        <!-- The two table cards (and their splitter) hide when the lobby holds no games at all -->
        <Style x:Key="TableCard" TargetType="Border" BasedOn="{StaticResource Card}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding ElementName=Me, Path=GameCount}" Value="0">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SplitterGrip" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource HairlineBrush}" />
            <Setter Property="CornerRadius" Value="2" />
            <Setter Property="IsHitTestVisible" Value="False" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding ElementName=Me, Path=GameCount}" Value="0">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="TableSplitter" TargetType="GridSplitter">
            <Style.Triggers>
                <DataTrigger Binding="{Binding ElementName=Me, Path=GameCount}" Value="0">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Single empty-state card, shown only while the lobby holds no games -->
        <Style x:Key="EmptyLobbyCard" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding ElementName=Me, Path=GameCount}" Value="0">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <UserControl.Triggers>
        <!-- Staggered entrance: fade + 12px slide up, ease-out -->
        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="BorderButtons" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.3" />
                    <DoubleAnimation Storyboard.TargetName="HeaderSlide" Storyboard.TargetProperty="Y" From="12" To="0" Duration="0:0:0.3">
                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                    </DoubleAnimation>

                    <DoubleAnimation Storyboard.TargetName="OfflineBanner" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.3" BeginTime="0:0:0.06" />
                    <DoubleAnimation Storyboard.TargetName="BannerSlide" Storyboard.TargetProperty="Y" From="12" To="0" Duration="0:0:0.3" BeginTime="0:0:0.06">
                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                    </DoubleAnimation>

                    <DoubleAnimation Storyboard.TargetName="OpenTablesCard" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.35" BeginTime="0:0:0.12" />
                    <DoubleAnimation Storyboard.TargetName="OpenSlide" Storyboard.TargetProperty="Y" From="12" To="0" Duration="0:0:0.35" BeginTime="0:0:0.12">
                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                    </DoubleAnimation>

                    <DoubleAnimation Storyboard.TargetName="InProgressCard" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.35" BeginTime="0:0:0.2" />
                    <DoubleAnimation Storyboard.TargetName="ProgressSlide" Storyboard.TargetProperty="Y" From="12" To="0" Duration="0:0:0.35" BeginTime="0:0:0.2">
                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </UserControl.Triggers>

    <Grid Margin="32,24,32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="0"/>
            <RowDefinition MinHeight="112" Height="*"/>
            <RowDefinition Height="12" />
            <RowDefinition MinHeight="112" Height="*" />
        </Grid.RowDefinitions>
        <Border x:Name="DialogPlaceHolder" Grid.RowSpan="8" Panel.ZIndex="10" Margin="-32,-24,-32,-24"></Border>

        <!-- Page header (shared template): 64px tall, title + subtitle left, actions right and centred -->
        <DockPanel x:Name="BorderButtons" Grid.Row="0" Height="64" IsEnabled="{Binding LoadingGame, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:PlayTab}}}">
            <DockPanel.RenderTransform>
                <TranslateTransform x:Name="HeaderSlide" />
            </DockPanel.RenderTransform>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                <Button Click="ButtonKillGame" Style="{StaticResource FlatDarkRedButtonStyle}" Height="36" Margin="0,0,8,0"
                        Visibility="{Binding ElementName=Me,Path=ShowKillGameButton,Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE711;" FontFamily="{StaticResource IconFont}" FontSize="12" VerticalAlignment="Center" Margin="0,1,8,0" />
                        <TextBlock Text="Kill Game" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Click="ButtonJoinOfflineGame" Style="{StaticResource GhostButton}" Height="36" Margin="0,0,8,0"
                        ToolTip="Connect to a game directly">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE71B;" FontFamily="{StaticResource IconFont}" FontSize="13" VerticalAlignment="Center" Margin="0,1,8,0" />
                        <TextBlock Text="Connect" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Click="ButtonJoinClick" Style="{StaticResource SecondaryButton}" Height="36" Margin="0,0,8,0"
                        ToolTip="Join the selected table"
                        IsEnabled="{Binding IsJoinableGameSelected, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:PlayTab}}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE768;" FontFamily="{StaticResource IconFont}" FontSize="12" VerticalAlignment="Center" Margin="0,1,8,0" />
                        <TextBlock Text="Join" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Click="ButtonHostClick" Style="{StaticResource PrimaryButton}" Height="36" Padding="18,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFont}" FontSize="13" VerticalAlignment="Center" Margin="0,1,8,0" />
                        <TextBlock Text="Host a game" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Game Lobby" Style="{StaticResource HeadingText}" FontSize="26" />
                <!-- Subtitle: neutral connection status, then the filter -->
                <StackPanel Orientation="Horizontal" Height="20" Margin="0,4,0,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                Visibility="{Binding ElementName=Me, Path=IsLoggedIn, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Ellipse Width="7" Height="7" Fill="#FF3DDC84" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock Style="{StaticResource BodyMutedText}" TextWrapping="NoWrap" VerticalAlignment="Center">
                            <Run Text="Online" /><Run Text=" · " /><Run Text="{Binding GameCount, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:PlayTab}}}" />
                        </TextBlock>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                Visibility="{Binding ElementName=Me, Path=IsLoggedIn, Converter={StaticResource InvertedBooleanToVisibilityConverter}}">
                        <Ellipse Width="7" Height="7" Fill="#FF6B6B75" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock Text="Offline" Style="{StaticResource BodyMutedText}" TextWrapping="NoWrap" VerticalAlignment="Center" />
                    </StackPanel>
                    <Rectangle Width="1" Height="14" Fill="{DynamicResource HairlineBrush}" VerticalAlignment="Center" Margin="14,0" />
                    <CheckBox VerticalAlignment="Center" IsChecked="{Binding ElementName=Me, Path=HideUninstalledGames}" Margin="0"
                              Foreground="{DynamicResource MutedTextBrush}" FontSize="13" Content="Only show installed games" />
                </StackPanel>
            </StackPanel>
        </DockPanel>

        <!-- 2px activity line; with its bottom margin it fills the 24px gap under the header -->
        <ProgressBar Grid.Row="1" Height="2" Margin="0,0,0,22" VerticalAlignment="Top" BorderThickness="0" Background="#FF1A1A1E" Foreground="#FF4A4A54" IsIndeterminate="{Binding ElementName=Me,Path=IsRefreshingGameList}" Maximum="200" Minimum="0">
            <ProgressBar.Style>
                <Style TargetType="{x:Type ProgressBar}" BasedOn="{StaticResource {x:Type ProgressBar}}">
                    <Style.Resources>
                        <Storyboard x:Key="InitialRefreshDelayAnimation">
                            <DoubleAnimation From="200" To="0" Storyboard.TargetProperty="Value" Duration="{x:Static local:PlayTab.InitialRefreshDelay}" />
                        </Storyboard>
                        <Storyboard x:Key="NormalRefreshDelayAnimation">
                            <DoubleAnimation From="200" To="0" Storyboard.TargetProperty="Value" Duration="{x:Static local:PlayTab.NormalRefreshDelay}" />
                        </Storyboard>
                    </Style.Resources>
                    <Style.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding ElementName=Me, Path=IsRefreshingGameList}" Value="False"/>
                                <Condition Binding="{Binding ElementName=Me, Path=IsInitialRefresh}" Value="True"/>
                            </MultiDataTrigger.Conditions>
                            <MultiDataTrigger.EnterActions>
                                <BeginStoryboard Name="InitialRefreshDelayBeginStoryboard" Storyboard="{StaticResource InitialRefreshDelayAnimation}"/>
                            </MultiDataTrigger.EnterActions>
                            <MultiDataTrigger.ExitActions>
                                <StopStoryboard BeginStoryboardName="InitialRefreshDelayBeginStoryboard"/>
                            </MultiDataTrigger.ExitActions>
                        </MultiDataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding ElementName=Me, Path=IsRefreshingGameList}" Value="False"/>
                                <Condition Binding="{Binding ElementName=Me, Path=IsInitialRefresh}" Value="False"/>
                            </MultiDataTrigger.Conditions>
                            <MultiDataTrigger.EnterActions>
                                <BeginStoryboard Name="NormalRefreshDelayBeginStoryboard" Storyboard="{StaticResource NormalRefreshDelayAnimation}"/>
                            </MultiDataTrigger.EnterActions>
                            <MultiDataTrigger.ExitActions>
                                <StopStoryboard BeginStoryboardName="NormalRefreshDelayBeginStoryboard"/>
                            </MultiDataTrigger.ExitActions>
                        </MultiDataTrigger>
                        <DataTrigger Binding="{Binding ElementName=Me, Path=IsRefreshingGameList}" Value="False">
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ProgressBar.Style>
        </ProgressBar>

        <!-- Shown until the user signs in: the one place the offline state is explained -->
        <Border x:Name="OfflineBanner" Grid.Row="2" Margin="0,0,0,12" Background="#0FFFFFFF" BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1" CornerRadius="12" Padding="14,10"
                Visibility="{Binding ElementName=Me, Path=IsLoggedIn, Converter={StaticResource InvertedBooleanToVisibilityConverter}}">
            <Border.RenderTransform>
                <TranslateTransform x:Name="BannerSlide" />
            </Border.RenderTransform>
            <DockPanel>
                <Border DockPanel.Dock="Left" Width="28" Height="28" CornerRadius="14" Background="#1AFFB84D" Margin="0,0,12,0" VerticalAlignment="Center">
                    <TextBlock Text="&#xE946;" FontFamily="{StaticResource IconFont}" FontSize="13" Foreground="#FFFFC875" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="You're browsing offline" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextBrush}" />
                    <TextBlock Style="{StaticResource CaptionText}" Margin="0,1,0,0" TextWrapping="Wrap"
                               Text="Only games on your local network are listed. Sign in on the Home tab to see online games." />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Empty state: replaces both tables while the lobby holds no games -->
        <Border x:Name="EmptyLobbyCard" Grid.Row="4" Grid.RowSpan="3" Style="{StaticResource EmptyLobbyCard}"
                HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="520" Padding="40,32">
            <StackPanel HorizontalAlignment="Center">
                <Border Width="56" Height="56" CornerRadius="28" Background="#0FFFFFFF" BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1" HorizontalAlignment="Center">
                    <TextBlock Text="&#xE716;" FontFamily="{StaticResource IconFont}" FontSize="24" Foreground="{DynamicResource MutedTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="No games in the lobby right now" FontFamily="{StaticResource DisplayFont}" FontSize="18" Foreground="{DynamicResource TextBrush}"
                           HorizontalAlignment="Center" TextAlignment="Center" Margin="0,16,0,0" />
                <TextBlock Style="{StaticResource BodyMutedText}" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,6,0,0"
                           Text="Host a game and others can join you, or connect to a friend's game directly." />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,24,0,0"
                            IsEnabled="{Binding LoadingGame, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:PlayTab}}}">
                    <Button Click="ButtonHostClick" Style="{StaticResource PrimaryButton}" Height="36" Padding="18,0" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFont}" FontSize="13" VerticalAlignment="Center" Margin="0,1,8,0" />
                            <TextBlock Text="Host a game" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Click="ButtonJoinOfflineGame" Style="{StaticResource SecondaryButton}" Height="36" Padding="18,0"
                            ToolTip="Connect to a game directly">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE71B;" FontFamily="{StaticResource IconFont}" FontSize="13" VerticalAlignment="Center" Margin="0,1,8,0" />
                            <TextBlock Text="Connect to a game" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Open tables -->
        <Border x:Name="OpenTablesCard" Grid.Row="4" Style="{StaticResource TableCard}" Padding="0">
            <Border.RenderTransform>
                <TranslateTransform x:Name="OpenSlide" />
            </Border.RenderTransform>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" Margin="16,12,16,4">
                    <TextBlock Text="&#xE716;" FontFamily="{StaticResource IconFont}" FontSize="13" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <TextBlock Text="OPEN TABLES" Style="{StaticResource EyebrowText}" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="Waiting for players. Double-click to join." Style="{StaticResource CaptionText}" VerticalAlignment="Center" Margin="12,0,0,0" />
                </StackPanel>
                <ListView x:Name="HostingGamesList" Grid.Row="1" utils:GridViewStretch.StretchColumn="3"
                          SelectedValue="{Binding ElementName=Me, Path=SelectedGame}"
                          AlternationCount="1"
                          SelectionMode="Single"
                          utils:GridViewSort.AutoSort="True"
                          Margin="0,0,0,6"
                          ItemsSource="{Binding HostedGameList, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:PlayTab}}}" >
                    <ListView.ItemContainerStyle>
                        <Style TargetType="{x:Type ListViewItem}" BasedOn="{StaticResource LobbyRow}">
                            <Setter Property="Visibility" Value="Visible" />
                            <EventSetter Event="MouseDoubleClick" Handler="GameListItemDoubleClick"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Status}" Value="GameInProgress">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Status}" Value="StoppedHosting">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding CanPlay}" Value="False" />
                                        <Condition Binding="{Binding ElementName=Me, Path=HideUninstalledGames}" Value="True"/>
                                    </MultiDataTrigger.Conditions>
                                    <MultiDataTrigger.Setters>
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </MultiDataTrigger.Setters>
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.View>
                        <GridView ColumnHeaderContainerStyle="{StaticResource LobbyColumnHeader}">
                            <GridViewColumn CellTemplate="{StaticResource UserIconTemplate}" Width="44"></GridViewColumn>
                            <GridViewColumn Header="User"
                                            utils:GridViewSort.PropertyName="UserName"
                                            CellTemplate="{StaticResource UserNameTemplate}" Width="120"></GridViewColumn>
                            <GridViewColumn Header="Game"
                                            utils:GridViewSort.PropertyName="GameName"
                                            CellTemplate="{StaticResource GameNameTemplate}" Width="170"></GridViewColumn>
                            <GridViewColumn Header="Table"
                                            utils:GridViewSort.PropertyName="Name"
                                            CellTemplate="{StaticResource TableNameTemplate}" Width="260"></GridViewColumn>
                            <GridViewColumn Header="Run time"
                                            utils:GridViewSort.PropertyName="StartTime"
                                            CellTemplate="{StaticResource RunTimeTemplate}" Width="88"></GridViewColumn>
                            <GridViewColumn Header="Source"
                                            utils:GridViewSort.PropertyName="Source"
                                            CellTemplate="{StaticResource SourceTemplate}" Width="96"></GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>
            </Grid>
        </Border>

        <GridSplitter Grid.Row="5" Style="{StaticResource TableSplitter}" Height="12" HorizontalAlignment="Stretch" VerticalAlignment="Center" Background="Transparent"
                      ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" Cursor="SizeNS" />
        <Border Grid.Row="5" Style="{StaticResource SplitterGrip}" Width="36" Height="4" />

        <!-- Games in progress -->
        <Border x:Name="InProgressCard" Grid.Row="6" Style="{StaticResource TableCard}" Padding="0">
            <Border.RenderTransform>
                <TranslateTransform x:Name="ProgressSlide" />
            </Border.RenderTransform>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" Margin="16,12,16,4">
                    <TextBlock Text="&#xE7B3;" FontFamily="{StaticResource IconFont}" FontSize="13" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <TextBlock Text="IN PROGRESS" Style="{StaticResource EyebrowText}" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="Already started. Double-click to spectate." Style="{StaticResource CaptionText}" VerticalAlignment="Center" Margin="12,0,0,0" />
                </StackPanel>
                <ListView x:Name="SpectatingGamesList" Grid.Row="1" utils:GridViewStretch.StretchColumn="3"
                          SelectedValue="{Binding ElementName=Me, Path=SelectedGame}"
                          AlternationCount="1"
                          SelectionMode="Single"
                          utils:GridViewSort.AutoSort="True"
                          Margin="0,0,0,6"
                          ItemsSource="{Binding HostedGameList, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:PlayTab}}}" >
                    <ListView.View>
                        <GridView ColumnHeaderContainerStyle="{StaticResource LobbyColumnHeader}">
                            <GridViewColumn CellTemplate="{StaticResource UserIconTemplate}" Width="44"></GridViewColumn>
                            <GridViewColumn Header="User"
                                            utils:GridViewSort.PropertyName="UserName"
                                            CellTemplate="{StaticResource UserNameTemplate}" Width="120"></GridViewColumn>
                            <GridViewColumn Header="Game"
                                            utils:GridViewSort.PropertyName="GameName"
                                            CellTemplate="{StaticResource GameNameTemplate}" Width="170"></GridViewColumn>
                            <GridViewColumn Header="Table"
                                            utils:GridViewSort.PropertyName="Name"
                                            CellTemplate="{StaticResource TableNameTemplate}" Width="260"></GridViewColumn>
                            <GridViewColumn Header="Run time"
                                            utils:GridViewSort.PropertyName="StartTime"
                                            CellTemplate="{StaticResource RunTimeTemplate}" Width="88"></GridViewColumn>
                            <GridViewColumn Header="Source"
                                            utils:GridViewSort.PropertyName="Source"
                                            CellTemplate="{StaticResource SourceTemplate}" Width="96"></GridViewColumn>
                        </GridView>
                    </ListView.View>
                    <ListView.ItemContainerStyle>
                        <Style TargetType="{x:Type ListViewItem}" BasedOn="{StaticResource LobbyRow}">
                            <Setter Property="Visibility" Value="Visible" />
                            <EventSetter Event="MouseDoubleClick" Handler="GameListItemDoubleClick"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Status}" Value="StartedHosting">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Status}" Value="StoppedHosting">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding CanPlay}" Value="False" />
                                        <Condition Binding="{Binding ElementName=Me, Path=HideUninstalledGames}" Value="True"/>
                                    </MultiDataTrigger.Conditions>
                                    <MultiDataTrigger.Setters>
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </MultiDataTrigger.Setters>
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ListView.ItemContainerStyle>
                </ListView>
            </Grid>
        </Border>
    </Grid>
</UserControl>
