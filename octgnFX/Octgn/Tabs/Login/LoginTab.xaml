<UserControl x:Class="Octgn.Tabs.Login.LoginTab" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:local="clr-namespace:Octgn.Tabs.Login"
      xmlns:utils="clr-namespace:Octgn.Utils"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" mc:Ignorable="d"
      d:DesignHeight="640" d:DesignWidth="1100"
      DataContext="{Binding RelativeSource={RelativeSource Self}}">
    <UserControl.Resources>
        <Style x:Key="LinkLabel" TargetType="Label">
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Cursor" Value="Hand" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
            <Setter Property="Margin" Value="2,0,0,8" />
        </Style>
        <Style x:Key="CommunityChip" TargetType="Border">
            <Setter Property="Background" Value="#CC17171B" />
            <Setter Property="BorderBrush" Value="#FF2A2A30" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="15" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Margin" Value="0,0,10,0" />
        </Style>
    </UserControl.Resources>

    <Viewbox Stretch="Uniform" StretchDirection="Both" MaxWidth="1500" MaxHeight="960" Margin="24" HorizontalAlignment="Center" VerticalAlignment="Center">
    <Grid x:Name="MainGrid" Width="820" Height="470">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MaxWidth="460" />
            <ColumnDefinition Width="48" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Left: brand, pitch and sign in -->
        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Padding="0,0,8,0" VerticalAlignment="Center">
        <StackPanel>
            <Border HorizontalAlignment="Left" Background="#1FFF0000" BorderBrush="#40FF3B3B" BorderThickness="1" CornerRadius="12" Padding="10,3" Margin="0,0,0,12">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="6" Height="6" Fill="#FFFF4D4D" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBlock Text="Online card &amp; tabletop gaming" FontSize="12" FontWeight="SemiBold" Foreground="#FFFFB3B3" />
                </StackPanel>
            </Border>
            <TextBlock FontFamily="{StaticResource DisplayFont}" FontSize="30" LineHeight="36" LineStackingStrategy="BlockLineHeight"
                       Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap">
                <Run Text="Every card game." />
                <LineBreak />
                <Run Text="One table.">
                    <Run.Foreground>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#FFFF3B3B" Offset="0" />
                            <GradientStop Color="#FFFF8A5C" Offset="1" />
                        </LinearGradientBrush>
                    </Run.Foreground>
                </Run>
            </TextBlock>
            <TextBlock Style="{StaticResource BodyMutedText}" FontSize="13.5" Margin="0,8,0,16" MaxWidth="420" HorizontalAlignment="Left"
                       Text="Host, join and spectate games with players around the world, using the games and decks you love." />

            <Border Style="{StaticResource Card}" Padding="22,16"
                    Visibility="{Binding LoginVM.LoggedIn, Converter={StaticResource InvertedBooleanToVisibilityConverter}}">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="32" ShadowDepth="8" Direction="270" Opacity="0.55" Color="Black" />
                </Border.Effect>
                <StackPanel IsEnabled="{Binding LoginVM.NotBusy}">
                    <TextBlock x:Name="textBlock1" Text="Sign in" Style="{StaticResource HeadingText}" FontSize="17" Margin="0,0,0,10" />

                    <Border Background="#26FF0000" BorderBrush="#66FF0000" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,16"
                            Visibility="{Binding LoginVM.HasError, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE783;" FontFamily="{StaticResource IconFont}" Foreground="#FFFF6B6B" FontSize="14" VerticalAlignment="Top" Margin="0,2,10,0" />
                            <TextBlock Style="{x:Null}" Text="{Binding LoginVM.ErrorString}" Foreground="#FFFFB3B3" FontSize="13" TextWrapping="Wrap" MaxWidth="320" />
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Email or username" Style="{StaticResource FieldLabel}" />
                    <TextBox Height="38" FontSize="14" Padding="12,0"
                             Text="{Binding LoginVM.Username, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Text="Password" Style="{StaticResource FieldLabel}" Margin="2,12,0,6" />
                    <PasswordBox Height="38" FontSize="14" Padding="12,0" KeyUp="PasswordBox1KeyUp"
                                 utils:PasswordBoxAssistant.BindPassword="true"
                                 utils:PasswordBoxAssistant.BoundPassword="{Binding LoginVM.Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <Button x:Name="button1" Click="Button1Click" Style="{StaticResource PrimaryButton}" Height="40" Margin="0,16,0,0" FontSize="14">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Sign in" VerticalAlignment="Center" />
                            <TextBlock Text="&#xE72A;" FontFamily="{StaticResource IconFont}" FontSize="12" Margin="10,1,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0" HorizontalAlignment="Center">
                        <Label x:Name="labelRegister" Style="{StaticResource LinkLabel}" Content="Create an account" />
                        <TextBlock Text="·" Foreground="{DynamicResource FaintTextBrush}" Margin="10,0" VerticalAlignment="Center" />
                        <Label x:Name="labelForgot" Style="{StaticResource LinkLabel}" Content="Forgot password?" />
                        <Label x:Name="labelSubscribe" Style="{StaticResource LinkLabel}" Content="Subscribe" Visibility="Collapsed" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
        </ScrollViewer>

        <!-- Right: community and news -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border x:Name="border3" Grid.Row="0" Grid.RowSpan="2" Style="{StaticResource Card}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="0,0,0,1" Padding="24,14,16,14">
                        <DockPanel>
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                <Border Style="{StaticResource CommunityChip}">
                                    <TextBlock FontSize="12">
                                        <Run Text="&#xE8BD;" FontFamily="{StaticResource IconFont}" Foreground="#FF8B9BFF" />
                                        <Hyperlink NavigateUri="https://discord.gg/Yn3Jrpj" RequestNavigate="Hyperlink_RequestNavigate">Discord</Hyperlink>
                                    </TextBlock>
                                </Border>
                                <Border Style="{StaticResource CommunityChip}" Margin="0">
                                    <TextBlock FontSize="12">
                                        <Run Text="&#xE789;" FontFamily="{StaticResource IconFont}" Foreground="#FF6CC4FF" />
                                        <Hyperlink NavigateUri="https://twitter.com/octgn_official" RequestNavigate="Hyperlink_RequestNavigate">Twitter</Hyperlink>
                                    </TextBlock>
                                </Border>
                            </StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="8" Height="8" Fill="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,10,0">
                                <Ellipse.Effect>
                                    <DropShadowEffect Color="Red" BlurRadius="8" ShadowDepth="0" Opacity="1" />
                                </Ellipse.Effect>
                            </Ellipse>
                            <TextBlock Text="LATEST NEWS" Style="{StaticResource EyebrowText}" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                        </DockPanel>
                    </Border>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,4,16,12">
                        <ItemsControl ItemsSource="{Binding LoginVM.News.Items}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type local:NewsItemViewModel}">
                                    <Grid Margin="0,0,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="22" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="1" HorizontalAlignment="Center" Background="{DynamicResource HairlineBrush}" Margin="0,18,0,-2" />
                                        <Ellipse Width="9" Height="9" VerticalAlignment="Top" Margin="0,18,0,0" Fill="#FF17171B" Stroke="#FFFF4D4D" StrokeThickness="2" HorizontalAlignment="Center" />
                                        <StackPanel Grid.Column="1" Margin="8,12,0,18">
                                            <TextBlock FontSize="14" Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap" LineHeight="21"
                                                       utils:TextBlockExtension.FormattedText="{Binding Path=Message}"
                                                       Text="{Binding Path=Message}" />
                                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                                <TextBlock Text="&#xE823;" FontFamily="{StaticResource IconFont}" FontSize="11" Foreground="{DynamicResource FaintTextBrush}" VerticalAlignment="Center" />
                                                <TextBlock Margin="7,0,0,0" FontSize="12" Foreground="{DynamicResource FaintTextBrush}" VerticalAlignment="Center"
                                                           Text="{Binding Path=Time.LocalDateTime, StringFormat='{}{0:MMMM d, yyyy}'}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
    </Viewbox>
</UserControl>
