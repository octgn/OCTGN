<UserControl x:Class="Octgn.Tabs.ChallengeBoards.ChallengeBoards"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:challengeBoards="clr-namespace:Octgn.Tabs.ChallengeBoards"
             xmlns:wpfCircularProgressBar="clr-namespace:WpfCircularProgressBar;assembly=WpfCircularProgressBar"
             xmlns:util="clr-namespace:Util;assembly=WpfCircularProgressBar"
             mc:Ignorable="d" 
             d:DesignHeight="300" d:DesignWidth="300"
             x:Name="self" DataContext="{Binding ElementName=self}">
    <UserControl.Resources>
        <Style TargetType="ProgressBar" x:Key="CircularProgressBarStyle">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid x:Name="LayoutRoot">
                            <!-- attach the view model -->
                            <wpfCircularProgressBar:CircularProgressBarViewModel.Attach>
                                <wpfCircularProgressBar:CircularProgressBarViewModel HoleSizeFactor="0.75"/>
                            </wpfCircularProgressBar:CircularProgressBarViewModel.Attach>


                            <!-- Track ring behind the progress wedge -->
                            <Ellipse Width="{Binding Diameter}" Height="{Binding Diameter}"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Stroke="#FF2A2A30" Fill="Transparent"
                       StrokeThickness="6.5">
                            </Ellipse>

                            <wpfCircularProgressBar:PiePiece CentreX="{Binding CentreX}" CentreY="{Binding CentreY}"
                              RotationAngle="-1" WedgeAngle="{Binding Angle}"
                              Radius="{Binding Radius}" InnerRadius="{Binding InnerRadius}"
                              Fill="{DynamicResource AccentBrush}" Opacity="0.9"/>

                            <Grid util:GridUtils.RowDefinitions="*,2*,*" util:GridUtils.ColumnDefinitions="*,2*,*">
                                <Viewbox Grid.Row="1" Grid.Column="1">
                                    <TextBlock Text="{Binding Percent, StringFormat=0%}"  Foreground="White" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                </Viewbox>
                            </Grid>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid Margin="32,26,32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0">
            <TextBlock Text="Challenge Board" Style="{StaticResource HeadingText}" FontSize="26" />
            <TextBlock Text="Community ladders and leagues. See who's leading and how far each board has run." Style="{StaticResource BodyMutedText}" Margin="0,4,0,0" />
        </StackPanel>
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="6" Margin="0,18,0,0">
            <ListBox x:Name="ListBoxBoards"
                     Background="Transparent" BorderThickness="0"
                     HorizontalContentAlignment="Stretch"
                     HorizontalAlignment="Stretch"
                     ItemContainerStyle="{StaticResource CardListItem}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ItemsSource="{Binding Boards}">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="challengeBoards:BoardViewModel">
                        <Grid Height="Auto" HorizontalAlignment="Stretch" DataContext="{Binding}" MinHeight="52" Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="52"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="100*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ProgressBar Style="{StaticResource CircularProgressBarStyle}" Width="52" Height="52"
                                         Value="{Binding Path=PercentComplete}" x:Name="Progress" Grid.Row="0"/>
                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap" />
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <TextBlock Text="&#xE77B;" FontFamily="{StaticResource IconFont}" FontSize="11" Foreground="{DynamicResource FaintTextBrush}" VerticalAlignment="Center" Margin="0,1,6,0" />
                                    <TextBlock Text="{Binding Owner.Name}" FontSize="12" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="·" FontSize="12" Foreground="{DynamicResource FaintTextBrush}" VerticalAlignment="Center" Margin="10,0" />
                                    <TextBlock Text="&#xE787;" FontFamily="{StaticResource IconFont}" FontSize="11" Foreground="{DynamicResource FaintTextBrush}" VerticalAlignment="Center" Margin="0,1,6,0" />
                                    <TextBlock Text="{Binding End, StringFormat='Ends {0:MMM d, yyyy}'}" FontSize="12" Foreground="{DynamicResource FaintTextBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                            </StackPanel>
                            <Button Grid.Column="3" Style="{StaticResource SecondaryButton}" Height="34" VerticalAlignment="Center" Click="ButtonBase_OnClick">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="View board" VerticalAlignment="Center" />
                                    <TextBlock Text="&#xE76C;" FontFamily="{StaticResource IconFont}" FontSize="10" VerticalAlignment="Center" Margin="8,1,0,0" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>
        <StackPanel Grid.Row="1" Margin="0,18,0,0" VerticalAlignment="Center" HorizontalAlignment="Center">
            <Border x:Name="NoBoardsMessage" Style="{StaticResource Card}" Visibility="Collapsed">
                <TextBlock Style="{StaticResource BodyMutedText}" HorizontalAlignment="Center" Text="There don't seem to be any boards right now, check back later." />
            </Border>
        </StackPanel>
    </Grid>
</UserControl>