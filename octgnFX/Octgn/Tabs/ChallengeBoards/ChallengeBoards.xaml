<UserControl x:Class="Octgn.Tabs.ChallengeBoards.ChallengeBoards"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:challengeBoards="clr-namespace:Octgn.Tabs.ChallengeBoards"
             xmlns:wpfCircularProgressBar="clr-namespace:WpfCircularProgressBar;assembly=WpfCircularProgressBar"
             xmlns:util="clr-namespace:Util;assembly=WpfCircularProgressBar"
             mc:Ignorable="d"
             d:DesignHeight="300" d:DesignWidth="300"
             x:Name="self" DataContext="{Binding ElementName=self}">
    <UserControl.Resources>
        <!-- Caption: the one small-text style (12.5px, muted) -->
        <Style x:Key="CaptionText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Effect" Value="{x:Null}" />
        </Style>

        <!-- Progress ring: neutral while running, green once the board is complete. The ring colour comes from Foreground. -->
        <Style TargetType="ProgressBar" x:Key="CircularProgressBarStyle">
            <Setter Property="Minimum" Value="0" />
            <Setter Property="Maximum" Value="100" />
            <Setter Property="Foreground" Value="#FFC9C9D1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid x:Name="LayoutRoot">
                            <!-- attach the view model -->
                            <wpfCircularProgressBar:CircularProgressBarViewModel.Attach>
                                <wpfCircularProgressBar:CircularProgressBarViewModel HoleSizeFactor="0.78"/>
                            </wpfCircularProgressBar:CircularProgressBarViewModel.Attach>

                            <!-- Track ring behind the progress wedge -->
                            <Ellipse Width="{Binding Diameter}" Height="{Binding Diameter}"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Stroke="#FF2A2A30" Fill="Transparent"
                       StrokeThickness="5">
                            </Ellipse>

                            <wpfCircularProgressBar:PiePiece CentreX="{Binding CentreX}" CentreY="{Binding CentreY}"
                              RotationAngle="-1" WedgeAngle="{Binding Angle}"
                              Radius="{Binding Radius}" InnerRadius="{Binding InnerRadius}"
                              Fill="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}}" Opacity="0.95"/>

                            <Grid util:GridUtils.RowDefinitions="*,2*,*" util:GridUtils.ColumnDefinitions="*,2*,*">
                                <Viewbox Grid.Row="1" Grid.Column="1">
                                    <TextBlock Text="{Binding Percent, StringFormat=0%}"  Foreground="White" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                </Viewbox>
                            </Grid>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <!-- Value is clamped to Maximum, so >= 100 percent lands here -->
                <Trigger Property="Value" Value="100">
                    <Setter Property="Foreground" Value="#FF4ADE80" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Board card: fades and rises in (staggered), lifts and brightens on hover -->
        <Style x:Key="BoardCard" TargetType="{x:Type ListBoxItem}">
            <Setter Property="Width" Value="316" />
            <Setter Property="Margin" Value="0,0,12,12" />
            <Setter Property="Padding" Value="16,14" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListBoxItem}">
                        <Grid x:Name="Root">
                            <Grid.RenderTransform>
                                <TranslateTransform x:Name="Enter" />
                            </Grid.RenderTransform>
                            <Grid x:Name="Inner">
                                <Grid.RenderTransform>
                                    <TranslateTransform x:Name="Lift" />
                                </Grid.RenderTransform>
                                <Border x:Name="Face" CornerRadius="12" BorderThickness="1" BorderBrush="#FF2C2C33">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#FF1F1F25" Offset="0" />
                                            <GradientStop Color="#FF18181C" Offset="1" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>
                                <Border x:Name="Hover" CornerRadius="12" BorderThickness="1" BorderBrush="#40FFFFFF" Background="#0DFFFFFF" Opacity="0" />
                                <ContentPresenter Margin="{TemplateBinding Padding}" />
                            </Grid>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12" />
                                            <DoubleAnimation Storyboard.TargetName="Lift" Storyboard.TargetProperty="Y" To="-2" Duration="0:0:0.15">
                                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18" />
                                            <DoubleAnimation Storyboard.TargetName="Lift" Storyboard.TargetProperty="Y" To="0" Duration="0:0:0.18" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <DataTrigger Binding="{Binding Path=(ItemsControl.AlternationIndex), RelativeSource={RelativeSource TemplatedParent}}" Value="0">
    <DataTrigger.EnterActions>
        <BeginStoryboard>
            <Storyboard>
                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Root" Storyboard.TargetProperty="Opacity">
                    <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                    
                    <EasingDoubleKeyFrame KeyTime="0:0:0.28" Value="1"><EasingDoubleKeyFrame.EasingFunction><CubicEase EasingMode="EaseOut" /></EasingDoubleKeyFrame.EasingFunction></EasingDoubleKeyFrame>
                </DoubleAnimationUsingKeyFrames>
                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Enter" Storyboard.TargetProperty="Y">
                    <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="12" />
                    
                    <EasingDoubleKeyFrame KeyTime="0:0:0.28" Value="0"><EasingDoubleKeyFrame.EasingFunction><CubicEase EasingMode="EaseOut" /></EasingDoubleKeyFrame.EasingFunction></EasingDoubleKeyFrame>
                </DoubleAnimationUsingKeyFrames>
            </Storyboard>
        </BeginStoryboard>
    </DataTrigger.EnterActions>
</DataTrigger>
<DataTrigger Binding="{Binding Path=(ItemsControl.AlternationIndex), RelativeSource={RelativeSource TemplatedParent}}" Value="1">
    <DataTrigger.EnterActions>
        <BeginStoryboard>
            <Storyboard>
                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Root" Storyboard.TargetProperty="Opacity">
                    <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                    <DiscreteDoubleKeyFrame KeyTime="0:0:0.035" Value="0" />
                    <EasingDoubleKeyFrame KeyTime="0:0:0.315" Value="1"><EasingDoubleKeyFrame.EasingFunction><CubicEase EasingMode="EaseOut" /></EasingDoubleKeyFrame.EasingFunction></EasingDoubleKeyFrame>
                </DoubleAnimationUsingKeyFrames>
                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Enter" Storyboard.TargetProperty="Y">
                    <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="12" />
                    <DiscreteDoubleKeyFrame KeyTime="0:0:0.035" Value="12" />
                    <EasingDoubleKeyFrame KeyTime="0:0:0.315" Value="0"><EasingDoubleKeyFrame.EasingFunction><CubicEase EasingMode="EaseOut" /></EasingDoubleKeyFrame.EasingFunction></EasingDoubleKeyFrame>
                </DoubleAnimationUsingKeyFrames>
            </Storyboard>
        </BeginStoryboard>
    </DataTrigger.EnterActions>
</DataTrigger>
<DataTrigger Binding="{Binding Path=(ItemsControl.AlternationIndex), RelativeSource={RelativeSource TemplatedParent}}" Value="2">
    <DataTrigger.EnterActions>
        <BeginStoryboard>
            <Storyboard>
                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Root" Storyboard.TargetProperty="Opacity">
                    <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                    <DiscreteDoubleKeyFrame KeyTime="0:0:0.07" Value="0" />
                    <EasingDoubleKeyFrame KeyTime="0:0:0.35" Value="1"><EasingDoubleKeyFrame.EasingFunction><CubicEase EasingMode="EaseOut" /></EasingDoubleKeyFrame.EasingFunction></EasingDoubleKeyFrame>
                </DoubleAnimationUsingKeyFrames>
                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Enter" Storyboard.TargetProperty="Y">
                    <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="12" />
                    <DiscreteDoubleKeyFrame KeyTime="0:0:0.07" Value="12" />
                    <EasingDoubleKeyFrame KeyTime="0:0:0.35" Value="0"><EasingDoubleKeyFrame.EasingFunction><CubicEase EasingMode="EaseOut" /></EasingDoubleKeyFrame.EasingFunction></EasingDoubleKeyFrame>
                </DoubleAnimationUsingKeyFrames>
            </Storyboard>
        </BeginStoryboard>
    </DataTrigger.EnterActions>
</DataTrigger>
<DataTrigger Binding="{Binding Path=(ItemsControl.AlternationIndex), RelativeSource={RelativeSource TemplatedParent}}" Value="3">
    <DataTrigger.EnterActions>
        <BeginStoryboard>
            <Storyboard>
                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Root" Storyboard.TargetProperty="Opacity">
                    <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                    <DiscreteDoubleKeyFrame KeyTime="0:0:0.105" Value="0" />
                    <EasingDoubleKeyFrame KeyTime="0:0:0.385" Value="1"><EasingDoubleKeyFrame.EasingFunction><CubicEase EasingMode="EaseOut" /></EasingDoubleKeyFrame.EasingFunction></EasingDoubleKeyFrame>
                </DoubleAnimationUsingKeyFrames>
                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Enter" Storyboard.TargetProperty="Y">
                    <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="12" />
                    <DiscreteDoubleKeyFrame KeyTime="0:0:0.105" Value="12" />
                    <EasingDoubleKeyFrame KeyTime="0:0:0.385" Value="0"><EasingDoubleKeyFrame.EasingFunction><CubicEase EasingMode="EaseOut" /></EasingDoubleKeyFrame.EasingFunction></EasingDoubleKeyFrame>
                </DoubleAnimationUsingKeyFrames>
            </Storyboard>
        </BeginStoryboard>
    </DataTrigger.EnterActions>
</DataTrigger>
<DataTrigger Binding="{Binding Path=(ItemsControl.AlternationIndex), RelativeSource={RelativeSource TemplatedParent}}" Value="4">
    <DataTrigger.EnterActions>
        <BeginStoryboard>
            <Storyboard>
                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Root" Storyboard.TargetProperty="Opacity">
                    <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                    <DiscreteDoubleKeyFrame KeyTime="0:0:0.14" Value="0" />
                    <EasingDoubleKeyFrame KeyTime="0:0:0.42" Value="1"><EasingDoubleKeyFrame.EasingFunction><CubicEase EasingMode="EaseOut" /></EasingDoubleKeyFrame.EasingFunction></EasingDoubleKeyFrame>
                </DoubleAnimationUsingKeyFrames>
                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Enter" Storyboard.TargetProperty="Y">
                    <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="12" />
                    <DiscreteDoubleKeyFrame KeyTime="0:0:0.14" Value="12" />
                    <EasingDoubleKeyFrame KeyTime="0:0:0.42" Value="0"><EasingDoubleKeyFrame.EasingFunction><CubicEase EasingMode="EaseOut" /></EasingDoubleKeyFrame.EasingFunction></EasingDoubleKeyFrame>
                </DoubleAnimationUsingKeyFrames>
            </Storyboard>
        </BeginStoryboard>
    </DataTrigger.EnterActions>
</DataTrigger>
<DataTrigger Binding="{Binding Path=(ItemsControl.AlternationIndex), RelativeSource={RelativeSource TemplatedParent}}" Value="5">
    <DataTrigger.EnterActions>
        <BeginStoryboard>
            <Storyboard>
                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Root" Storyboard.TargetProperty="Opacity">
                    <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                    <DiscreteDoubleKeyFrame KeyTime="0:0:0.175" Value="0" />
                    <EasingDoubleKeyFrame KeyTime="0:0:0.455" Value="1"><EasingDoubleKeyFrame.EasingFunction><CubicEase EasingMode="EaseOut" /></EasingDoubleKeyFrame.EasingFunction></EasingDoubleKeyFrame>
                </DoubleAnimationUsingKeyFrames>
                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Enter" Storyboard.TargetProperty="Y">
                    <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="12" />
                    <DiscreteDoubleKeyFrame KeyTime="0:0:0.175" Value="12" />
                    <EasingDoubleKeyFrame KeyTime="0:0:0.455" Value="0"><EasingDoubleKeyFrame.EasingFunction><CubicEase EasingMode="EaseOut" /></EasingDoubleKeyFrame.EasingFunction></EasingDoubleKeyFrame>
                </DoubleAnimationUsingKeyFrames>
            </Storyboard>
        </BeginStoryboard>
    </DataTrigger.EnterActions>
</DataTrigger>

                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <UserControl.Triggers>
        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="HeaderBlock" Storyboard.TargetProperty="Opacity">
                        <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                        <EasingDoubleKeyFrame KeyTime="0:0:0.3" Value="1"><EasingDoubleKeyFrame.EasingFunction><CubicEase EasingMode="EaseOut" /></EasingDoubleKeyFrame.EasingFunction></EasingDoubleKeyFrame>
                    </DoubleAnimationUsingKeyFrames>
                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="HeaderShift" Storyboard.TargetProperty="Y">
                        <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="12" />
                        <EasingDoubleKeyFrame KeyTime="0:0:0.3" Value="0"><EasingDoubleKeyFrame.EasingFunction><CubicEase EasingMode="EaseOut" /></EasingDoubleKeyFrame.EasingFunction></EasingDoubleKeyFrame>
                    </DoubleAnimationUsingKeyFrames>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </UserControl.Triggers>

    <Grid Margin="32,26,32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Page header: title + subtitle left, actions right and centred on the title block -->
        <Grid x:Name="HeaderBlock" Grid.Row="0" Height="64">
            <Grid.RenderTransform>
                <TranslateTransform x:Name="HeaderShift" />
            </Grid.RenderTransform>
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Left">
                <TextBlock Text="Challenge Board" FontFamily="{StaticResource DisplayFont}" FontSize="26" Foreground="{DynamicResource TextBrush}" />
                <TextBlock Text="Community ladders and leagues. See who's leading and how far each board has run." FontSize="13" Foreground="{DynamicResource MutedTextBrush}" Margin="0,4,0,0" />
            </StackPanel>
            <Border HorizontalAlignment="Right" VerticalAlignment="Center" Margin="16,0,0,0" CornerRadius="12" Padding="10,3" Background="#14FFFFFF" BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1">
                <TextBlock Text="{Binding ElementName=ListBoxBoards,Path=Items.Count,StringFormat='{}{0} boards'}" Style="{StaticResource CaptionText}" FontWeight="SemiBold" TextWrapping="NoWrap" />
            </Border>
        </Grid>

        <!-- Boards: bottom edge fades so it is clear the list scrolls -->
        <ListBox x:Name="ListBoxBoards" Grid.Row="1" Style="{StaticResource WrapListBoxStyle}" Margin="0,24,0,0"
                 Background="Transparent" BorderThickness="0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 AlternationCount="6"
                 ItemsSource="{Binding Boards}"
                 ItemContainerStyle="{StaticResource BoardCard}">
            <ListBox.OpacityMask>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#FF000000" Offset="0" />
                    <GradientStop Color="#FF000000" Offset="0.92" />
                    <GradientStop Color="#1A000000" Offset="1" />
                </LinearGradientBrush>
            </ListBox.OpacityMask>
            <ListBox.ItemTemplate>
                <DataTemplate DataType="challengeBoards:BoardViewModel">
                    <Grid DataContext="{Binding}" Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="56"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="100*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Progress ring: neutral while running, green when complete -->
                        <ProgressBar Style="{StaticResource CircularProgressBarStyle}" Width="56" Height="56" VerticalAlignment="Center"
                                     Value="{Binding Path=PercentComplete}" x:Name="Progress" Grid.Column="0"/>

                        <DockPanel Grid.Column="2" VerticalAlignment="Center">
                            <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Width="32" Height="32" MinHeight="0" Padding="0" Margin="8,0,0,0" VerticalAlignment="Center"
                                    ToolTip="View board" Click="ButtonBase_OnClick">
                                <TextBlock Text="&#xE76C;" FontFamily="{StaticResource IconFont}" FontSize="12" />
                            </Button>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="15" Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
                                <DockPanel Margin="0,4,0,0">
                                    <TextBlock DockPanel.Dock="Left" Text="&#xE77B;" FontFamily="{StaticResource IconFont}" FontSize="12" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" Margin="0,1,6,0" />
                                    <TextBlock Text="{Binding Owner.Name}" Style="{StaticResource CaptionText}" TextWrapping="NoWrap" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                </DockPanel>
                                <DockPanel Margin="0,4,0,0">
                                    <TextBlock DockPanel.Dock="Left" Text="&#xE787;" FontFamily="{StaticResource IconFont}" FontSize="12" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" Margin="0,1,6,0" />
                                    <TextBlock DockPanel.Dock="Right" Text="Complete" Margin="8,0,0,0" FontSize="12.5" FontWeight="SemiBold" Foreground="#FF6EE7A0" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ElementName=Progress,Path=Value}" Value="100">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="{Binding End, StringFormat='Ends {0:MMM d, yyyy}'}" Style="{StaticResource CaptionText}" TextWrapping="NoWrap" VerticalAlignment="Center" />
                                </DockPanel>
                            </StackPanel>
                        </DockPanel>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Empty / offline state: upper third, hidden as soon as the list has boards -->
        <StackPanel x:Name="NoBoardsMessage" Grid.Row="1" Margin="0,64,0,0" VerticalAlignment="Top" HorizontalAlignment="Center" MaxWidth="420">
            <StackPanel.Style>
                <Style TargetType="StackPanel">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ElementName=ListBoxBoards,Path=HasItems}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>
            <StackPanel.Triggers>
                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="Opacity">
                                <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                <EasingDoubleKeyFrame KeyTime="0:0:0.35" Value="1"><EasingDoubleKeyFrame.EasingFunction><CubicEase EasingMode="EaseOut" /></EasingDoubleKeyFrame.EasingFunction></EasingDoubleKeyFrame>
                            </DoubleAnimationUsingKeyFrames>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </StackPanel.Triggers>
            <Border Width="48" Height="48" CornerRadius="24" Background="#14FFFFFF" HorizontalAlignment="Center">
                <TextBlock Text="&#xE7C1;" FontFamily="{StaticResource IconFont}" FontSize="20" Foreground="{DynamicResource MutedTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <TextBlock Text="No boards to show yet" Style="{StaticResource HeadingText}" FontSize="17" HorizontalAlignment="Center" Margin="0,14,0,0" />
            <TextBlock Style="{StaticResource CaptionText}" TextAlignment="Center" Margin="0,6,0,0"
                       Text="Boards load from challengeboards.net. If this stays empty the site may be unreachable, so check back in a few minutes." />
        </StackPanel>
    </Grid>
</UserControl>
