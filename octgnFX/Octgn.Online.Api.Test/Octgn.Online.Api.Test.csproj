<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <IsTestProject>true</IsTestProject>
    <IsPackable>false</IsPackable>
    <ProductionSourceRoot Condition="'$(ProductionSourceRoot)' == ''">../Octgn.Online/Api</ProductionSourceRoot>
    <DefineConstants Condition="'$(Baseline)' == 'true'">$(DefineConstants);BASELINE</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="NUnit" Version="3.13.3" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.3.1" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.2" />
    <Compile Include="$(ProductionSourceRoot)/ApiClientException.cs" Link="Production/ApiClientException.cs" />
    <Compile Include="$(ProductionSourceRoot)/ApiClient.cs" Link="Production/ApiClient.cs" />
    <Compile Include="../Octgn.Online/Api/ExtensionMethods.cs" Link="Production/ExtensionMethods.cs" />
    <Compile Include="../Octgn.Online/Api/StatType.cs" Link="Production/StatType.cs" />
    <Compile Include="../Octgn.Online/Api/Models/*.cs" Link="Production/Models/%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
